/* ============================================================
   LectureCapture — Light theme
   Warm cream / ivory palette so it never blinds. Soft warm-black
   text, one coral accent, generous radius and padding.

   Palette
     bg / panel        #f4f1e8   warm cream
     well (lists)      #ece8dc
     elevated          #eae5d7   inputs, buttons, cards
     elevated hover    #e1dbc9
     elevated pressed  #d6cfbb
     border            #ddd6c4
     text              #423f37   warm soft-black
     muted             #837c6c
     accent            #c15f3c   coral (deeper for contrast)
     accent hover      #ab5333
   ============================================================ */

/* ---- Base ---- */
QWidget {
    background-color: #f4f1e8;
    color: #423f37;
    font-family: "Segoe UI", "Inter", system-ui, sans-serif;
    font-size: 13px;
}

QToolTip {
    background-color: #ffffff;
    color: #423f37;
    border: 1px solid #ddd6c4;
    border-radius: 6px;
    padding: 5px 8px;
}

/* ---- Buttons ---- */
QPushButton {
    background-color: #eae5d7;
    color: #423f37;
    border: 1px solid #ddd6c4;
    border-radius: 8px;
    padding: 7px 14px;
}
QPushButton:hover {
    background-color: #e1dbc9;
    border-color: #cdc4ad;
}
QPushButton:pressed {
    background-color: #d6cfbb;
}
QPushButton:focus {
    border-color: #c15f3c;
    outline: none;
}
QPushButton:disabled {
    background-color: #efece2;
    color: #b3ac9b;
    border-color: #e3ddce;
}

/* Panel-visibility toggles (transcript header): lit when the panel is shown,
   muted when it's collapsed — so the button itself signals the panel's state.
   :enabled-scoped so it never overrides the disabled/locked look. */
QPushButton[panelOpen="true"]:enabled {
    border-color: #c15f3c;
    background-color: #efe7d6;
}
QPushButton[panelOpen="true"]:enabled:hover {
    border-color: #ab5333;
    background-color: #e1dbc9;
}
QPushButton[panelOpen="false"]:enabled {
    color: #9a9384;
    background-color: #efece2;
}
QPushButton[panelOpen="false"]:enabled:hover {
    color: #837c6c;
    background-color: #e1dbc9;
}

/* Flat icon buttons in the title bar */
QPushButton#titleBarButton {
    background: transparent;
    border: none;
    border-radius: 8px;
}
QPushButton#titleBarButton:hover {
    background-color: #e1dbc9;
}
QPushButton#titleBarButton:pressed {
    background-color: #d6cfbb;
}

/* Big icon-over-text tiles in Settings (Local/API, themes, prefs) */
QToolButton {
    background-color: #eae5d7;
    color: #423f37;
    border: 1px solid #ddd6c4;
    border-radius: 10px;
    padding: 10px;
}
QToolButton:hover {
    background-color: #e1dbc9;
    border-color: #c15f3c;
}
QToolButton:pressed {
    background-color: #d6cfbb;
}
/* Active choice in a settings toggle group (Local/API, theme, prefs) */
QToolButton[selected="true"] {
    border: 2px solid #c15f3c;
    background-color: #efe7d6;
}
QToolButton[selected="true"]:hover {
    background-color: #e1dbc9;
    border-color: #ab5333;
}

/* ---- Check boxes ---- */
QCheckBox {
    background: transparent;
    color: #423f37;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #b8af9a;      /* visible against the cream bg */
    border-radius: 5px;
    background-color: #fbf9f2;
}
QCheckBox::indicator:hover {
    border-color: #c15f3c;
}
QCheckBox::indicator:checked {
    background-color: #efe7d6;
    border-color: #c15f3c;           /* coral border + ✕ = checked */
    image: url(__ASSETS__/icons/x_dark.svg);
}
QCheckBox::indicator:checked:hover {
    background-color: #e1dbc9;
    border-color: #ab5333;
}
QCheckBox::indicator:disabled {
    border-color: #e3ddce;
    background-color: #f0ede3;
}
QCheckBox:disabled {
    color: #b3ac9b;
}

/* ---- Radio buttons (quiz options) ---- */
QRadioButton {
    background: transparent;
    color: #423f37;
    spacing: 8px;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #c15f3c;       /* coral — visible on the cream bg */
    border-radius: 8px;              /* circular */
    background-color: #fbf9f2;
}
QRadioButton::indicator:hover {
    border-color: #ab5333;
}
QRadioButton::indicator:checked {
    background-color: #c15f3c;        /* solid coral when selected */
    border-color: #c15f3c;
}
QRadioButton::indicator:checked:hover {
    background-color: #ab5333;
    border-color: #ab5333;
}
QRadioButton:disabled {
    color: #b3ac9b;
}

/* ---- Text inputs ---- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox {
    background-color: #fbf9f2;
    color: #423f37;
    border: 1px solid #ddd6c4;
    border-radius: 8px;
    padding: 7px 10px;
    selection-background-color: #c15f3c;
    selection-color: #fbf9f2;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QComboBox:focus, QComboBox:on {
    border: 1px solid #c15f3c;
}
QLineEdit:disabled, QTextEdit:disabled, QSpinBox:disabled, QComboBox:disabled {
    color: #b3ac9b;
    background-color: #f0ede3;
}

/* SpinBox steppers — quiet, no hard borders */
QSpinBox::up-button, QSpinBox::down-button {
    background: transparent;
    border: none;
    width: 18px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background: #e1dbc9;
}

/* ComboBox dropdown */
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox QAbstractItemView {
    background-color: #fbf9f2;
    color: #423f37;
    border: 1px solid #ddd6c4;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #e1dbc9;
    selection-color: #423f37;
    outline: none;
}

/* ---- Lists ---- */
QListWidget {
    background-color: #ece8dc;
    border: 1px solid #ddd6c4;
    border-radius: 10px;
    padding: 6px;
    outline: none;
}
QListWidget::item {
    padding: 0px;
    margin: 2px 0;
    border-radius: 8px;
}
QListWidget::item:hover {
    background-color: #f4f1e8;
}
QListWidget::item:selected {
    background-color: #e1dbc9;
    color: #423f37;
}
QListWidget::item:disabled {
    background: transparent;
    color: #837c6c;
    padding-left: 4px;
    padding-top: 6px;
}

/* ---- Context menus ---- */
QMenu {
    background-color: #fbf9f2;
    border: 1px solid #ddd6c4;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 18px;
    border-radius: 6px;
}
QMenu::item:selected {
    background-color: #e1dbc9;
}

/* ---- Scroll areas — visible border so OCR/speech panels are distinct ---- */
QScrollArea {
    border: 1px solid #ddd6c4;
    border-radius: 6px;
    background-color: #ece8dc;
}

/* ---- Scrollbars ---- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #d3cbb6;
    border-radius: 5px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover {
    background: #c2b9a0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #d3cbb6;
    border-radius: 5px;
    min-width: 28px;
}
QScrollBar::handle:horizontal:hover {
    background: #c2b9a0;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0px;
    width: 0px;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ---- Splitter — barely-there divider ---- */
QSplitter::handle {
    background-color: #f4f1e8;
}
QSplitter::handle:horizontal {
    width: 8px;
}
QSplitter::handle:vertical {
    height: 8px;
}
QSplitter::handle:hover {
    background-color: #e1dbc9;
}

/* ---- Labels ---- */
QLabel {
    background: transparent;
    border: none;
}
QLabel#muted {
    color: #837c6c;
    font-size: 12px;
}
QLabel#sectionHeader {
    font-size: 15px;
    font-weight: 600;
    color: #423f37;
}
QLabel#dangerHeader {
    font-size: 15px;
    font-weight: 600;
    color: #b54b35;
}
QFrame#sectionDivider {
    border: none;
    border-top: 1px solid #ddd6c4;
    max-height: 1px;
}
/* Translate/Define result card (frameless popup) */
QWidget#lookupCard {
    background-color: #fbf9f2;
    border: 1px solid #cdc4ad;
    border-radius: 12px;
}
/* Selected/original text inside the card — muted plain text that scrolls when tall */
QTextEdit#lookupOriginal {
    background: transparent;
    border: none;
    padding: 0;
    color: #837c6c;
    font-size: 12px;
}
/* Recording-time connection/API warning bar above the engine labels */
#connectionBanner {
    background-color: #d9534f;
    border-radius: 8px;
}
#connectionBannerText {
    background: transparent;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
}
#connectionBannerClose {
    background: transparent;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    padding: 0;
}
#connectionBannerClose:hover {
    background: rgba(255, 255, 255, 0.25);
}

/* Quiz review cards (per-question results) */
QFrame#quizCard {
    background-color: #fbf9f2;
    border: 1px solid #cdc4ad;
    border-radius: 10px;
}

/* Help guide — placeholder boxes where step-by-step screenshots will go */
QLabel#helpImage {
    border: 1px dashed #c2b9a3;
    border-radius: 10px;
    background-color: #f3efe5;
    color: #837c6c;
    padding: 8px;
}
/* Coral frame/mat around an actual help screenshot (matches active-button accent) */
QFrame#helpScreenshot {
    background-color: #c15f3c;
    border-radius: 6px;
}

/* Key-cap chips in the keyboard-shortcuts dialog */
QLabel#kbd {
    background-color: #eae5d7;
    color: #423f37;
    border: 1px solid #cdc4ad;
    border-radius: 6px;
    padding: 2px 8px;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
}

/* Session cards are transparent so the list row's hover/selection shows through */
SessionCard {
    background: transparent;
}

/* Session name underline separator in the transcript header */
QFrame#sessionNameSep {
    border: none;
    border-top: 1px solid #c8c0ae;
    max-height: 1px;
}

/* Properties panel — left border to visually separate it from the transcript */
QWidget#propertiesPanel {
    border-left: 2px solid #ddd6c4;
}

/* ---- Dialogs / message boxes ---- */
QDialog, QMessageBox {
    background-color: #f4f1e8;
}
QMessageBox QPushButton {
    min-width: 84px;
}

/* ---- Frameless window caption buttons ---- */
MinimizeButton, MaximizeButton, CloseButton {
    background: transparent;
}
MinimizeButton {
    qproperty-normalColor: #423f37;
    qproperty-hoverColor: #000000;
    qproperty-pressedColor: #837c6c;
    qproperty-hoverBackgroundColor: rgba(0, 0, 0, 18);
    qproperty-pressedBackgroundColor: rgba(0, 0, 0, 28);
}
MaximizeButton {
    qproperty-normalColor: #423f37;
    qproperty-hoverColor: #000000;
    qproperty-pressedColor: #837c6c;
    qproperty-hoverBackgroundColor: rgba(0, 0, 0, 18);
    qproperty-pressedBackgroundColor: rgba(0, 0, 0, 28);
}
CloseButton {
    qproperty-normalColor: #423f37;
    qproperty-hoverColor: #ffffff;
    qproperty-hoverBackgroundColor: #c5402f;
    qproperty-pressedBackgroundColor: #a8341f;
}

/* ---- Title bar bottom border ---- */
TitleBar {
    border-bottom: 1px solid #ddd6c4;
}
